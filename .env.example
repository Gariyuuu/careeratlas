# Copy this file to .env and fill in values as needed.
# The app runs with zero configuration beyond DATABASE_URL — every other
# variable below is optional and unlocks additional functionality.

# --- Database ---
# PostgreSQL connection string (Supabase, Neon, Vercel Postgres, etc).
# Supabase: Project Settings -> Database -> Connection string -> URI.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# --- Auth (NextAuth) ---
# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-insecure-secret-change-me"

# --- Cron protection ---
# If set, /api/cron/update-trends requires `Authorization: Bearer <value>`.
# Leave unset for local development.
CRON_SECRET=""

# --- Optional official data connectors ---
# BLS public API works without a key at a low rate limit; a free
# registration key raises the daily quota. https://www.bls.gov/developers/
BLS_API_KEY=""

# Not yet wired to a connector — reserved for a future Census ACS importer.
# https://www.census.gov/data/developers.html
CENSUS_API_KEY=""

# Not yet wired to a connector — reserved for a future College Scorecard
# importer. https://collegescorecard.ed.gov/data/documentation/
COLLEGE_SCORECARD_API_KEY=""
